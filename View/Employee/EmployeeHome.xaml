<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DistributeurATM.View.Employee.EmployeeHome"
             Title="EmployeeHome">
    <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <Button x:Name="AddCustomers" Clicked="AddCustomers_Clicked" WidthRequest="200" HeightRequest="200" Text="Add Customers"/>
        <Button x:Name="BossPage" Clicked="BossPage_Clicked" WidthRequest="200" HeightRequest="200" Text="Money Transfer"/>
        <Button x:Name="CreateAccount" Clicked="CreateAccount_Clicked" WidthRequest="200" HeightRequest="200" Text="Create Account"/>
    </HorizontalStackLayout>
</ContentPage>