<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DistributeurATM.View.BossPage"
             xmlns:local="clr-namespace:DistributeurATM.ViewModel"
             x:DataType="local:bossViewModel"
             Title="All Customers">
    
    <VerticalStackLayout Margin="25">
        <Picker ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" ItemDisplayBinding="{Binding Name}"/>
        <VerticalStackLayout Spacing="5">
            <Label Text="Username"/>
            <Entry IsReadOnly="True" Placeholder="Username" Text="{Binding SelectedCustomer.Name}"/>
            <Label Text="Money"/>
            <Entry IsReadOnly="True" Placeholder="Money" Text="{Binding SelectedCustomer.Money}"/>
            <Label Text="Password"/>
            <Entry IsVisible="{Binding IsNotAdmin}" IsPassword="True" IsReadOnly="True" Placeholder="Password" Text="{Binding SelectedCustomer.Password}"/>
            <Entry IsVisible="{Binding IsAdmin}" IsReadOnly="True" Placeholder="Password" Text="{Binding SelectedCustomer.Password}"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
    
</ContentPage>