<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DistributeurATM.View.CreateAccounts"
             xmlns:local="clr-namespace:DistributeurATM.ViewModel"
             Title="CreateAccounts">

    <ContentPage.BindingContext>
        <local:CreateAccountViewModel/>
    </ContentPage.BindingContext>
    
    <VerticalStackLayout>
        <Entry Placeholder="Username" Text="{Binding Username}"/>
        
        <Entry Placeholder="Password" Text="{Binding Password}"/>

        <Button Text="Create" Command="{Binding AddCommand}"/>
    </VerticalStackLayout>
</ContentPage>