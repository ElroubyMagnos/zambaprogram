<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DistributeurATM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DistributeurATM"
    xmlns:view="clr-namespace:DistributeurATM.View"
    Shell.FlyoutBehavior="Flyout"
    Title="DistributeurATM">

    <FlyoutItem Title="User">
        <Tab>
            <ShellContent
              Title="Dépôtpage"
              Route="depotpage"
              ContentTemplate="{DataTemplate view:dépôtpage}" />
            
            <ShellContent
              Title="Transfert"
              Route="Transfert"
              ContentTemplate="{DataTemplate view:moneytrans}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Employee">
        <Tab>
            <ShellContent
              Title="BossPage"
              Route="bossPage"
              ContentTemplate="{DataTemplate view:bossPage}" />
        </Tab>
    </FlyoutItem>
</Shell>
